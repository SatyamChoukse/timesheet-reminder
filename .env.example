# ─────────────────────────────────────────────
#  Timesheet Dog – default configuration
#  These are the defaults. Anything you change in
#  the Settings window overrides them.
# ─────────────────────────────────────────────

# Reminder
REMINDER_TIME=18:00
# Snooze choices shown under "Remind me later" (minutes)
SNOOZE_OPTIONS=10,30,60
# Days the dog shows up (0 = Sunday ... 6 = Saturday)
WORKDAYS=1,2,3,4,5

# Timesheet
TIMESHEET_URL=https://example.com/timesheet

# Behaviour
SOUND_ENABLED=true
AUTO_START=true
# Your pet: beagle, shiba, corgi, husky or cat
DOG_SKIN=beagle
# Pop out now and then during the workday to say hi
SURPRISE_PEEKS=false
# How long the happy dog stays after you click YES
HAPPY_DISMISS_SECONDS=3
# After "Fill Timesheet", ask again after this many minutes (0 = don't)
FILL_FOLLOWUP_MINUTES=30
# How often the scheduler checks the clock
CHECK_INTERVAL_SECONDS=30
# Wait while a fullscreen app or presentation is running
RESPECT_FULLSCREEN=true
# Give the dog keyboard focus when it appears (Y / N / Esc work right away)
REMINDER_TAKES_FOCUS=false

# Window
# auto = transparent, but solid over Remote Desktop / without GPU compositing
WINDOW_MODE=auto
# Size in pixels
DOG_WIDTH=390
DOG_HEIGHT=510
SCREEN_MARGIN=8
